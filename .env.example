# FlightAware AeroAPI (https://www.flightaware.com/commercial/aeroapi/)
FLIGHTAWARE_AEROAPI_KEY=

# Bearer token for /api/check, /api/track, /api/simulate, /test UI calls
FLIGHTCHECK_TOKEN=

# HMAC-SHA256 for X-Flightcheck-Signature on outbound webhooks
FLIGHTCHECK_WEBHOOK_SECRET=

# Vercel Cron Authorization: Bearer $CRON_SECRET for /api/tick
CRON_SECRET=

# Global AeroAPI spend cap per UTC day (estimate). Default 0.50
FLIGHTCHECK_DAILY_BUDGET_USD=0.50

# Upstash Redis (Vercel Marketplace). Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
