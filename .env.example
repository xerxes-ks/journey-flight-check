# FlightAware AeroAPI (https://www.flightaware.com/commercial/aeroapi/)
FLIGHTAWARE_AEROAPI_KEY=

# Bearer token for /api/check, /api/track, /api/simulate, /test UI calls
FLIGHTCHECK_TOKEN=

# HMAC-SHA256 for X-Flightcheck-Signature on outbound webhooks
FLIGHTCHECK_WEBHOOK_SECRET=

# Comma-separated hosts allowed for outbound webhooks (HTTPS only, no redirects).
# VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL are also allowed.
# FLIGHTCHECK_WEBHOOK_ALLOWED_HOSTS=example.test

# Vercel Cron Authorization: Bearer $CRON_SECRET for /api/tick
CRON_SECRET=

# Global AeroAPI spend cap per UTC day (estimate). Default 0.50.
# Applies to /api/track, /api/check and /api/tick. 0 means zero paid calls.
FLIGHTCHECK_DAILY_BUDGET_USD=0.50

# Private Vercel Blob (default store when set). Same token for prod / preview / dev.
BLOB_READ_WRITE_TOKEN=

# Optional override: blob (default) | memory (local smoke) | redis (needs KV/Upstash)
# FLIGHTCHECK_STORAGE=memory

# live (default) | fixtures (bundled synthetic AeroAPI; honour `now`)
# FLIGHTCHECK_MODE=fixtures

# Optional Redis. Used only when FLIGHTCHECK_STORAGE=redis.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
