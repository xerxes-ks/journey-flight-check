{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/health.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" },
    "api/check.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" },
    "api/track.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" },
    "api/untrack.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" },
    "api/tracked.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" },
    "api/events.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" },
    "api/tick.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" },
    "api/simulate.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" },
    "api/webhook-sink.py": { "maxDuration": 30, "excludeFiles": "{tests,.github,scripts,docs}/**" }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/test", "destination": "/test/index.html" },
    { "source": "/api/track/:id", "destination": "/api/track?id=:id" },
    { "source": "/api/untrack/:id", "destination": "/api/untrack?id=:id" },
    { "source": "/api/tracked/:id/events", "destination": "/api/events?id=:id" },
    { "source": "/api/tracked/:id", "destination": "/api/tracked?id=:id" }
  ]
}
